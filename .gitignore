#############################################
# PYTHON (BACKEND)
#############################################

# виртуальное окружение
venv/
env/
.venv/

# кеши
__pycache__/
*.py[cod]
*.pyo
*.pyd

# compiled
*.so

# Django
**/migrations/__pycache__/
**/migrations/*.pyc

# Игнорировать сгенерированные миграции?
# ❗ ВАЖНО: миграции нужно коммитить
# **/migrations/ — НЕ ИГНОРИРУЕМ

# SQLite (если вдруг останется)
*.sqlite3

# Атрибуты Django
staticfiles/
media/
media/**/*


